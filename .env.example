# Browser-safe public API endpoint used by the existing TAHTI/Lukkarikone data layer.
# Leave empty to use the built-in production fallback.
VITE_API_BASE_URL=https://lukkari-api.juh.fi/api
VITE_REALIZATION_API_BASE_URL=https://lukkari-api.juh.fi

# GitHub Pages base path. CI sets this automatically to /<repository>/.
# Use / for local development or a custom-domain deployment.
VITE_BASE_PATH=/
